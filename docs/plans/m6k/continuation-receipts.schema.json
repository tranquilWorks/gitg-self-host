{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "GG-M6K-PROGRAM-RECEIPTS-1.0"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "task_hash",
          "state",
          "actor_kind",
          "execution",
          "decision_reference",
          "reason",
          "dependencies",
          "bindings",
          "criteria"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "task_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "state": {
            "enum": [
              "pass",
              "pending",
              "blocked"
            ]
          },
          "actor_kind": {
            "enum": [
              "agent",
              "human"
            ]
          },
          "execution": {
            "enum": [
              "executed",
              "collected",
              "unavailable"
            ]
          },
          "decision_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "pointer",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "pointer": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "verdict",
                "reason",
                "anchors"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "verdict": {
                  "enum": [
                    "pass",
                    "pending",
                    "blocked"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "anchors": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "pointer",
                      "sha256"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "pointer": {
                        "type": "string"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
