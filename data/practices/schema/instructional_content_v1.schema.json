{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "competency_id",
    "title",
    "scored",
    "sections",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "GG-INSTRUCTIONAL-CONTENT-1.0"
    },
    "competency_id": {
      "type": "string",
      "pattern": "^[0-9]{2}\\.[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scored": {
      "const": false
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "body"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "concept",
              "material",
              "worked_example",
              "prompt",
              "pathway",
              "next_step"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "references": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "check_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "attempt_mode": {
            "enum": [
              "unaided",
              "cued",
              "looked_up",
              "open_explanation",
              "practice"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "prompt"
                }
              }
            },
            "then": {
              "required": [
                "check_id",
                "attempt_mode"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "check_id"
                    ]
                  },
                  {
                    "required": [
                      "attempt_mode"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "body",
          "criteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
